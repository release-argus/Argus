# Require a login, with users, groups and API tokens. Uncomment to enable, then
# create the first administrator on the setup page, or up front with
# `argus -auth.create-admin <username>`.
#settings:
#  auth:
#    enabled: true
service:
  release-argus/Argus:
    latest_version:
      type: github
      url: release-argus/Argus
    dashboard:
      icon: https://raw.githubusercontent.com/release-argus/Argus/master/web/ui/react-app/public/favicon.svg
      icon_link_to: https://release-argus.io
      web_url: https://github.com/release-argus/Argus/blob/master/CHANGELOG.md
